# dependencies
node_modules/

# vite cache
.vite/

# tsc incremental build info
*.tsbuildinfo

# logs
*.log
npm-debug.log*

# editor
.DS_Store

# NOTE: dist/ is intentionally committed. The host's webui_server serves
# the built files straight from webui/dist/ and never runs npm. If you
# change anything under src/, run `npm install && npm run build` and
# commit the regenerated dist/. The root .gitignore excludes dist/ so we
# force it back in here.
!dist/
!dist/**
