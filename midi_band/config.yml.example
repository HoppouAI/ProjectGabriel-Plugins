# midi_band local config. Copy this file to config.yml in the same folder
# and edit the values. Anything you set here OVERRIDES whatever is in the
# host's main config.yml under plugins.midi_band.*. Anything you leave
# blank falls through to the main config (or built-in defaults).

# 'host' or 'client'.
# - host: this instance runs the band server, owns the song library and
#   the AI tools that pick songs / assign tracks / start playback. Also
#   plays back its own assigned tracks.
# - client: this instance connects to a host and only plays the tracks
#   the host hands it. The AI tools on a client are status-only.
role: host

# Friendly label your bandmates see in logs and assignments.
instance_name: gabriel_a

# host only, network interface to bind on. 0.0.0.0 = all NICs.
bind: 0.0.0.0

# client only, where to dial the host (its LAN IP).
host_address: 192.168.1.50

# TCP port. Must match on every band member.
port: 8784

# Path to the .sf2 soundfont fluidsynth uses to synthesize notes. Required
# for midi band mode (the default). Not needed if you only ever use audio
# band mode. Pick anything you have, GeneralUser GS / FluidR3_GM / Arachno
# are good free defaults.
soundfont: "sfx/soundfonts/default.sf2"

# Library of .mid / .midi files. Host only really uses this. Clients
# receive the file from the host on demand and cache it under
# data/plugins/midi_band/received/.
# Default (when blank): the plugin's own midi/ subfolder, ie
# plugins/midi_band/midi/. Drop your .mid files there for the easiest
# setup.
library_dir: ""

# Synth output gain 0.0 - 2.0.
synth_gain: 0.5

# fluidsynth audio driver. Blank = autodetect.
# windows: "dsound" or "wasapi"
# linux:   "alsa" or "pulseaudio" or "pipewire"
# mac:     "coreaudio"
audio_driver: ""

# Output device for AUDIO BAND mode (the stem player, separate from the
# fluidsynth driver above). Accepts a device index or a name substring,
# eg "CABLE Input" to route this bandmate into a virtual cable. Blank =
# system default. Needs sounddevice + soundfile + numpy installed.
audio_device: ""

# How far in the future the host commits the start time once everyone
# has acked ready. Bigger = more sync slack on slow LANs, smaller =
# snappier downbeat. The full prepare/ready handshake adds up to ~3s
# extra on top of this for the file transfer + ack window.
schedule_lead_seconds: 1.5

# Lower number = higher priority in the chatbox.
chatbox_priority: 25

# Built-in web control room. Host only. A DAW-style UI for browsing and
# uploading songs, manually assigning tracks to each bandmate, and
# driving playback (play/pause/stop/soundcheck/volume). Once enabled it
# serves at http://<host_ip>:<webui_port>/. No auth, so only enable on a
# trusted LAN. Set webui_bind: 127.0.0.1 to keep it local-only.
webui_enabled: true
webui_bind: 0.0.0.0
webui_port: 8783

# On Windows, if libfluidsynth-3.dll cant be found on the system the
# plugin will download the latest official build from the FluidSynth
# GitHub releases and extract it under data/plugins/midi_band/fluidsynth/.
# Set to false to disable that and require a system install.
auto_install_fluidsynth: true

# AI conductor. From the web control room you can type a vibe ("stripped
# back and moody, keep me on piano") and the model assigns every track to
# a bandmate for you. Host only. Needs google-genai installed and a
# Gemini API key.
# Key lookup order: conductor_api_key below, then the host's main Gemini
# key, then the GEMINI_API_KEY environment variable. Leave blank to use
# whichever of those is already set.
conductor_api_key: ""
# Gemini model the conductor uses.
conductor_model: "gemini-3.1-flash-lite"

